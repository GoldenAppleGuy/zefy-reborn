{
  "api": 1,
  "id": "zefy",
  "name": "Zefy Reborn",
  "icon": "zefy.png",
  "requires": [
    "{jbroot}/usr/bin/zefy"
  ],
  "actions": [
    {
      "command": "playback",
      "name": "Playback",
      "icon": "playpause.fill",
      "options": [
        {
          "id": "mode",
          "title": "State",
          "choices": [
            {
              "word": "toggle",
              "label": "Toggle",
              "value": "--toggle"
            },
            {
              "word": "pause",
              "label": "Pause",
              "value": "--pause"
            },
            {
              "word": "resume",
              "label": "Resume",
              "value": "--resume"
            }
          ]
        }
      ],
      "run": [
        {
          "exec": [
            "{jbroot}/bin/sh",
            "{jbroot}/usr/bin/zefy",
            "--toggle"
          ],
          "as": "result",
          "if": {
            "var": "mode",
            "unset": true
          }
        },
        {
          "exec": [
            "{jbroot}/bin/sh",
            "{jbroot}/usr/bin/zefy",
            "{mode}"
          ],
          "as": "result"
        }
      ],
      "banner": {
        "title": "Spotify",
        "subtitle": "{result}",
        "icon": "playpause.fill"
      }
    },
    {
      "command": "skip",
